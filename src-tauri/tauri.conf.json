{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MQDesk",
  "version": "0.1.0",
  "identifier": "com.mqdesk.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MQDesk — RabbitMQ 可视化管控台",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; connect-src 'self' http://127.0.0.1:* http://localhost:* https://fonts.googleapis.com https://fonts.gstatic.com ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "publisher": "MQDesk",
    "category": "Utility",
    "shortDescription": "RabbitMQ 可视化管控台",
    "longDescription": "MQDesk 是一款面向小白/初级用户的 RabbitMQ 桌面可视化管控工具，让不懂 AMQP、看不懂英文管理后台的人也能在 5 分钟内连接服务、看懂队列状态、发送并监听消息。",
    "windows": {
      "wix": {
        "language": ["zh-CN", "en-US"]
      },
      "nsis": {
        "installMode": "both",
        "installerHooks": "windows/nsis-hooks.nsh",
        "template": "windows/installer.nsi"
      },
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    },
    "resources": {
      "WebView2Loader.dll": "WebView2Loader.dll"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {}
}
