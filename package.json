{
  "name": "mqdesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MQDesk — RabbitMQ 可视化管控台（小白友好的桌面工具）",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:win": "tauri build",
    "tauri:build:linux": "powershell -ExecutionPolicy Bypass -File scripts/build-linux.ps1",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@preact/signals": "^1.3.0",
    "@tauri-apps/api": "^2.1.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "preact": "^10.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@preact/preset-vite": "^2.9.1",
    "@tauri-apps/cli": "^2.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/preact": "^3.2.4",
    "esbuild": "^0.24.0",
    "jsdom": "^25.0.0",
    "lefthook": "^1.8.2",
    "oxlint": "^0.11.1",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
