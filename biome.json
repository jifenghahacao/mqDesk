{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "organizeImports": {
    "enabled": true
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "ignore": [
      "node_modules",
      "dist",
      "src-tauri/target",
      "src-tauri/gen/schemas",
      "legacy",
      ".changes",
      ".specs",
      "package-lock.json"
    ],
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "ignore": ["node_modules", "dist", "src-tauri/target", "src-tauri/gen/schemas", "legacy", ".changes", ".specs"],
    "rules": {
      "recommended": false,
      "style": {
        "noVar": "error",
        "useConst": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "arrowParentheses": "always"
    },
    "jsxRuntime": "transparent"
  },
  "css": {
    "formatter": {
      "enabled": true
    }
  },
  "json": {
    "formatter": {
      "enabled": true
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  }
}
